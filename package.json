{
  "name": "open-crew-jarvis",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --require ./tests/setup-env.js --test tests/*.test.js",
    "check": "node scripts/check-syntax.js && npm test",
    "config:check": "node scripts/check-config.js",
    "diagnose:voice": "node scripts/diagnose-voice.js",
    "diagnose:memory": "node scripts/diagnose-memory.js",
    "doctor": "node scripts/doctor.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:model": "node scripts/model-benchmark.js",
    "benchmark:model:live": "node scripts/model-benchmark.js --live",
    "voice:report": "node scripts/voice-report.js",
    "voice:calibrate": "bash scripts/calibrate-live.sh",
    "voice:sample": "node scripts/voice-benchmark.js",
    "voice:wake-collect": "bash scripts/collect-wake-samples.sh",
    "voice:wake-train": "bash scripts/train-wake-model.sh",
    "voice:wake-benchmark": ".venv-openwakeword/bin/python scripts/benchmark-wake-model.py",
    "voice:uzbek-preview": "node scripts/preview-uzbek-speech.js",
    "deps:check": "node scripts/check-runtime-deps.js",
    "security:scan": "bash scripts/scan-secrets.sh",
    "verify": "npm run deps:check && npm run check && npm run config:check && npm run diagnose:voice && npm run benchmark",
    "benchmark:actions": "node scripts/action-benchmark.js",
    "test:e2e": "node scripts/test-e2e-voice.js"
  },
  "dependencies": {
    "@picovoice/porcupine-node": "^4.0.2",
    "axios": "^1.7.9",
    "microsoft-cognitiveservices-speech-sdk": "^1.43.0",
    "node-record-lpcm16": "^1.0.1",
    "node-telegram-bot-api": "^1.2.0",
    "pg": "^8.23.0",
    "ws": "8.21.0"
  }
}
