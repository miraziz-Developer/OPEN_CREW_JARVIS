#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
LABEL="com.jarvis.openclaw"
DOMAIN="gui/$(id -u)"

usage() {
  echo "Usage: ./jarvis {install|start|stop|restart|status|doctor|logs|open|brain local|brain cloud|brain status|update|reconfigure|uninstall}"
}

case "${1:-start}" in
  install)
    exec "$ROOT/install.sh"
    ;;
  brain)
    # ./jarvis brain local | cloud | status
    if [ "${2:-status}" = status ]; then curl -s http://127.0.0.1:11435/brain/status || echo "Brain xizmati ishlamayapti"; echo; exit 0; fi
    node "$ROOT/scripts/set-brain.js" "$2" && exec "$0" restart
    ;;
  update)
    exec "$ROOT/scripts/update.sh"
    ;;
  reconfigure)
    exec "$ROOT/install.sh" --reconfigure
    ;;
  doctor)
    cd "$ROOT" && exec npm run -s doctor
    ;;
  uninstall)
    exec "$ROOT/scripts/uninstall.sh"
    ;;
  start)
    for L in com.jarvis.ollama com.jarvis.brain; do P="$HOME/Library/LaunchAgents/$L.plist"; [ -f "$P" ] && launchctl bootstrap "$DOMAIN" "$P" 2>/dev/null || true; done
    if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
      launchctl kickstart "$DOMAIN/$LABEL"
    else
      "$ROOT/scripts/enable-autostart.sh"
    fi
    echo "✅ Jarvis ishga tushdi"
    ;;
  stop)
    launchctl kill TERM "$DOMAIN/$LABEL" 2>/dev/null || true
    # Lokal miya xizmatlari ham (RAM to'liq bo'shaydi)
    for L in com.jarvis.brain com.jarvis.ollama; do launchctl bootout "$DOMAIN/$L" 2>/dev/null || true; done
    echo "⏹ Jarvis to'xtatildi"
    ;;
  restart)
    if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
      launchctl kickstart -k "$DOMAIN/$LABEL"
    else
      "$ROOT/scripts/enable-autostart.sh"
    fi
    echo "🔄 Jarvis to'liq qayta ishga tushirildi"
    ;;
  status)
    if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
      echo "✅ Jarvis: running"
    else
      echo "❌ Jarvis: stopped"
    fi
    curl -fsS --max-time 2 http://127.0.0.1:7890/api/status >/dev/null 2>&1 \
      && echo "✅ Dashboard: http://localhost:7890" \
      || echo "❌ Dashboard: unavailable"
    ;;
  open)
    open http://localhost:7890
    ;;
  logs)
    mkdir -p "$ROOT/logs"
    tail -f "$ROOT/logs/jarvis-$(date +%Y%m%d).log"
    ;;
  *) usage; exit 2 ;;
esac