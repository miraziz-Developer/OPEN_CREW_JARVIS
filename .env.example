# ═════════════════════════════════════════════════════════════
# JARVIS — English Realtime AI Agent Configuration
# ────────────────────────────────────────────────────────────
# Kalitlarni to'ldiring, .env.example ni .env nusxasi sifatida ishlating.
# HECH QACHON haqiqiy qiymatlarni .env.example ga YOZMAY  va gitga COMMIT qilma.
# ═════════════════════════════════════════════════════════════

# ┌───────────────────────────────────────────────────────────┐
# │  1. AZURE SPEECH SERVICE (STT + TTS) — Majburiy           │
# └───────────────────────────────────────────────────────────┘
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=...
AZURE_SPEECH_VOICE=en-US-GuyNeural
AZURE_SPEECH_LANGUAGE=en-US

# ┌───────────────────────────────────────────────────────────┐
# │  2. AI PROVIDER — Azure OpenAI Responses API               │
# └───────────────────────────────────────────────────────────┘
AZURE_OPENAI_ENDPOINT=...
AZURE_OPENAI_KEY=...
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra
# Expert/reasoning default primary deployment bilan bir xil. Faqat alohida
# deployment ishlatmoqchi bo'lsangiz o'zgartiring.
DEEP_THINK_MODEL=gpt-6-astra
DEEP_THINK_TIMEOUT_MS=90000
DEEP_THINK_MAX_TOKENS=1200
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4.1

# IKKI MARTA QARSAK TRIGGER
CLAP_TRIGGER_ENABLED=true
CLAP_SPIKE_RATIO=4
CLAP_ABS_FLOOR=250
WAKEWORD_THRESHOLD=0.35

# ┌───────────────────────────────────────────────────────────┐
# │  3. DESKTOP CONTROL (autonomous kompyuter boshqaruvi)     │
# └───────────────────────────────────────────────────────────┘
DESKTOP_CONTROL_ENABLED=true
DESKTOP_APPROVAL_MODE=ask
DESKTOP_FAILSAFE_CORNER=bottom-right

# ┌───────────────────────────────────────────────────────────┐
# │  4. MEMORY — Xotira tizimi                                │
# └───────────────────────────────────────────────────────────┘
MEMORY_DIR=./memory
MEMORY_MAX_ENTRIES=500
OBSIDIAN_VAULT="~/Documents/Obsidian Vault"
OBSIDIAN_MEMORY_DIR="~/Documents/Obsidian Vault/memory"
OBSIDIAN_ENABLED=true

# ┌───────────────────────────────────────────────────────────┐
# │  5. MESSAGING — Telegram / Discord / Email                │
# └───────────────────────────────────────────────────────────┘
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...

# OpenClaw gateway uchun kamida 32 byte tasodifiy token yarating:
# openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=...

# Ixtiyoriy: bepul, to'liq lokal "Hey Jarvis" wake-word.
# Birinchi marta: ./scripts/setup-openwakeword.sh
OPENWAKEWORD_ENABLED=true
# Pastroq qiymat sezgirroq; false-positive ko'payishi mumkin.
# Aksent va noutbuk mikrofoni uchun temporal tasdiqlash: 320ms oyna ichida
# bitta asosiy score va bitta yumshoq score talab qilinadi. False trigger bo'lsa
# asosiy thresholdni 0.22–0.30 oralig'iga ko'taring.
OPENWAKEWORD_THRESHOLD=0.18
OPENWAKEWORD_STRONG_THRESHOLD=0.55
OPENWAKEWORD_CONFIRM_THRESHOLD=0.06
OPENWAKEWORD_CONFIRM_WINDOW_FRAMES=4
OPENWAKEWORD_DIAGNOSTIC_FLOOR=0.03
OPENWAKEWORD_INPUT_GAIN=3
# SMTP_HOST=...
# SMTP_USER=...
# SMTP_PASS=...

# ┌───────────────────────────────────────────────────────────┐
# │  6. PROACTIVE — Avtomatik proactive rejim                 │
# └───────────────────────────────────────────────────────────┘
PROACTIVE_ENABLED=false
PROACTIVE_INTERVAL_MIN=30
PROACTIVE_COOLDOWN_MIN=30
PROACTIVE_DAILY_BUDGET=8
PROACTIVE_CONTEXT_MEMORY=10
# Operational interruption controls. Privacy suppresses all proactive notices;
# focus/meeting mode allows only urgency >= 0.9.
JARVIS_PRIVACY_MODE=false
JARVIS_FOCUS_MODE=false
JARVIS_MEETING_MODE=false

# ┌───────────────────────────────────────────────────────────┐
# │  7. ADVANCED TTS — ElevenLabs (professional ovoz)         │
# └───────────────────────────────────────────────────────────┘
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# ┌───────────────────────────────────────────────────────────┐
# │  8. SEARCH & KNOWLEDGE                                    │
# └───────────────────────────────────────────────────────────┘
# SERPAPI_KEY=...
# GOOGLE_CSE_ID=...
# GOOGLE_CSE_API_KEY=...

# ┌───────────────────────────────────────────────────────────┐
# │  9. SYSTEM CONFIG                                         │
# └───────────────────────────────────────────────────────────┘
JARVIS_LANG=en-US
JARVIS_NAME=Jarvis
TIMEZONE=Asia/Kuala_Lumpur
LOG_LEVEL=info

# EKRAN KUZATUV (fon rejimida doim ishlaydi)
SCREEN_MONITOR_ENABLED=true
SCREEN_MONITOR_INTERVAL=20000
SCREEN_MONITOR_THRESHOLD=15
SCREEN_MONITOR_VISION_COOLDOWN=120000

# DASHBOARD (http://localhost:7890, faqat mahalliy)
DASHBOARD_PORT=7890

# ┌───────────────────────────────────────────────────────────┐
# │  11. REALTIME VOICE — Haqiqiy real-vaqtli suhbat (gpt-realtime) │
# └───────────────────────────────────────────────────────────┘
REALTIME_ENABLED=true
REALTIME_IDLE_MS=20000
REALTIME_WAKE_PREROLL_MS=1800
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_REALTIME_VOICE=cedar
# Original deep, controlled cinematic machine persona (not an actor clone).
JARVIS_VOICE_STYLE=cinematic-robot
REALTIME_TRANSCRIPTION_LANGUAGE=en
REALTIME_VAD_SILENCE_MS=420
REALTIME_MEDIA_VAD_SILENCE_MS=750
REALTIME_MAX_RESPONSE_TOKENS=512
# Qisqa fast-action tasdiqlarining audiosi ham token limitiga kiradi; 40 juda
# past bo'lib, "Hozir soat 20:20" jumlasini o'rtasida kesib qo'ygan.
REALTIME_FAST_ACTION_MAX_RESPONSE_TOKENS=256
REALTIME_BARGE_IN_CONFIRM_MS=300
# Realtime PCM oqimidagi qisqa tarmoq jitterini yutish uchun boshlang'ich
# playback zaxirasi. Kamaytirish latency'ni, oshirish uzluksizlikni yaxshilaydi.
REALTIME_PLAYBACK_PREBUFFER_MS=240
REALTIME_PLAYBACK_MAX_WAIT_MS=320
MIC_MUTE_GRACE_MS=900
DUPLEX_ECHO_THRESHOLD=0.72
DUPLEX_BARGE_IN_RMS=650
DUPLEX_NOISE_FLOOR=80
DUPLEX_NOISE_MULTIPLIER=2.4
DUPLEX_HANGOVER_MS=650
DUPLEX_MAX_ECHO_LAG_MS=180
RUN_TASK_TIMEOUT_MS=180000
# Accepted turn shu vaqt ichida terminal holatga yetmasa watchdog uni failed
# sifatida yopadi. Startup replay terminal turnlarni idempotent qayta yozadi.
TURN_STALE_TIMEOUT_MS=600000
# Follow-up references remain active across short voice sessions. High-impact
# actions require an explicit one-shot confirmation inside this TTL.
CONVERSATION_FOLLOWUP_MS=20000
ACTION_CONFIRMATION_TTL_MS=30000
# Durable addressed-turn journal rotation (8 MiB, five archived segments).
TURN_JOURNAL_MAX_BYTES=8388608
TURN_JOURNAL_RETENTION_FILES=5

# Voice tuning, deduplication va provider circuit-breaker
# Realtime mikrofon uchun kechikishsiz speech-band filtri: past g'uvillash va
# 16 kHz nutq diapazonidan tashqaridagi yuqori shovqinni SoX orqali kesadi.
MIC_FILTER_ENABLED=true
MIC_HIGHPASS_HZ=80
MIC_LOWPASS_HZ=7600
ENERGY_MIN_STT=120
VOICE_ACTIVITY_THRESHOLD=150
HOTWORD_COOLDOWN_MS=3000
COMMAND_DEDUP_MS=5000
RESPONSE_DEDUP_MS=15000
REALTIME_INPUT_GAIN=3
REALTIME_FAILURE_LIMIT=3
REALTIME_COOLDOWN_MS=120000

# Chrome ochilganda profil-tanlash oynasisiz to'g'ridan-to'g'ri shu profil ochilsin
CHROME_DEFAULT_PROFILE=Default

# Kunlik o'z-o'zini hisobot
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=22

# Ko'p bosqichli avtonom loyihalar
PROJECTS_ENABLED=true

# Google Calendar/Gmail integratsiyasi (OAuth2 Desktop app — console.cloud.google.com)
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
