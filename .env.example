# ═════════════════════════════════════════════════════════════
# 🇺🇿 JARVIS v3 — Real AI Agent Configuration
# ────────────────────────────────────────────────────────────
# Jarvis'ni ishga tushirishdan oldin kerakli kalitlarni to'ldiring
# Kalit olmasdan qoldirilgan joylar avtomatik o'tqazib yuboriladi
# ═════════════════════════════════════════════════════════════

# ┌───────────────────────────────────────────────────────────┐
# │  1. AZURE SPEECH SERVICE (STT + TTS) — Majburiy           │
# │     https://portal.azure.com → Cognitive Services         │
# └───────────────────────────────────────────────────────────┘
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=uz-UZ-SardorNeural
AZURE_SPEECH_LANGUAGE=uz-UZ

# ┌───────────────────────────────────────────────────────────┐
# │  2. AI PROVIDER — Azure OpenAI / Azure AI Foundry         │
# │     (Kimi 2.6 modeli Azure orqali)                        │
# └───────────────────────────────────────────────────────────┘
AZURE_LLM_ENDPOINT=
AZURE_LLM_API_KEY=
AZURE_LLM_DEPLOYMENT_NAME=Kimi-K2.6

# Eski nomlar (mavjud bo'lsa, yangi nomlarga nusxalang)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=Kimi-K2.6

# ┌───────────────────────────────────────────────────────────┐
# │  3. DESKTOP CONTROL (autonomous kompyuter boshqaruvi)     │
# └───────────────────────────────────────────────────────────┘
DESKTOP_CONTROL_ENABLED=true
DESKTOP_APPROVAL_MODE=pause
DESKTOP_FAILSAFE_CORNER=bottom-right

# ┌───────────────────────────────────────────────────────────┐
# │  4. MEMORY — Xotira tizimi                                │
# └───────────────────────────────────────────────────────────┘
MEMORY_DIR=./memory
MEMORY_MAX_ENTRIES=500
OBSIDIAN_VAULT=~/Documents/Obsidian Vault
OBSIDIAN_MEMORY_DIR=~/Documents/Obsidian Vault/memory
OBSIDIAN_ENABLED=true

# ┌───────────────────────────────────────────────────────────┐
# │  5. SYSTEM CONFIG                                         │
# └───────────────────────────────────────────────────────────┘
JARVIS_LANG=uz-UZ
JARVIS_NAME=Jarvis
TIMEZONE=Asia/Kuala_Lumpur
LOG_LEVEL=info
