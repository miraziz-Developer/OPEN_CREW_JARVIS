# ══════════════════════════════════════════════════════════════════════════════
#  JARVIS configuration
#  `./install.sh` copies this file to .env and asks for the secrets interactively.
#  Empty values are secrets you fill in yourself. .env is git-ignored.
#  Every value below is optional unless marked REQUIRED.
# ══════════════════════════════════════════════════════════════════════════════

# ── Brain: Azure OpenAI (REQUIRED) ───────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_VISION_DEPLOYMENT=
# Simple turns use the fast model; tools, coding and complex tasks use the strong one.
AGENT_FAST_MODEL=gpt-6-astra
AGENT_STRONG_MODEL=gpt-6-sol
AGENT_STRONG_FALLBACK_MODELS=gpt-6-astra,gpt-5.6-sol,gpt-5-mini
DEEP_THINK_COMPLEX_MODEL=gpt-6-sol
DEEP_THINK_FAST_MODEL=gpt-6-astra
DEEP_THINK_MAX_TOKENS=
DEEP_THINK_TIMEOUT_MS=240000

# ── Google Gemini (recommended: fastest realtime voice, free tier) ───────────
# Key from https://aistudio.google.com/apikey. Also used for vision and speech-to-text.
GEMINI_API_KEY=
# gemini = Gemini Live is the primary realtime voice; azure = Azure Voice Live first.
REALTIME_VOICE_PROVIDER=gemini
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Prebuilt Gemini voice: Charon (deep), Puck, Kore, Fenrir, Orus, Aoede, ...
GEMINI_LIVE_VOICE=Charon

# ── Speech: Azure Speech (REQUIRED for wake confirmation and TTS) ────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE=en-US-OnyxTurboMultilingualNeural
AZURE_SPEECH_PITCH_PERCENT=-12
AZURE_SPEECH_RATE_PERCENT=-12
JARVIS_VOICE=en-US-AndrewNeural

# ── Realtime voice: Azure Voice Live / Azure Realtime (fallback providers) ───
AZURE_VOICELIVE_ENDPOINT=
AZURE_VOICELIVE_KEY=
AZURE_VOICELIVE_API_KEY=
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_VOICE=en-US-OnyxTurboMultilingualNeural
AZURE_VOICELIVE_API_VERSION=2026-04-10
AZURE_VOICELIVE_WAKE_PREFIX_PADDING_MS=100
AZURE_VOICELIVE_WAKE_SILENCE_MS=250
AZURE_VOICELIVE_SESSION_PREFIX_PADDING_MS=40
AZURE_VOICELIVE_INTERRUPT_RESPONSE=false
AZURE_REALTIME_ENDPOINT=
AZURE_REALTIME_KEY=
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_REALTIME_VOICE=cedar

# ── Realtime conversation tuning ─────────────────────────────────────────────
REALTIME_ENABLED=true
REALTIME_INPUT_GAIN=2
REALTIME_VAD_SILENCE_MS=180
REALTIME_NORMAL_DUPLEX_HANGOVER_MS=330
REALTIME_PLAYBACK_PREBUFFER_MS=80
REALTIME_PLAYBACK_MAX_WAIT_MS=200
REALTIME_BARGE_IN_CONFIRM_MS=500
REALTIME_BARGE_IN_MAX_GAP_MS=80
# Close the realtime connection after this much silence (mic audio streams while it is open).
REALTIME_IDLE_MS=120000
REALTIME_MAX_RESPONSE_TOKENS=
REALTIME_FAST_ACTION_MAX_RESPONSE_TOKENS=
REALTIME_TRANSCRIPTION_LANGUAGE=
REALTIME_WAKE_PREROLL_MS=1800
REALTIME_MEDIA_VAD_SILENCE_MS=750
REALTIME_FAILURE_LIMIT=3
REALTIME_COOLDOWN_MS=120000
# Window after a reply in which you can keep talking without saying "Jarvis".
CONVERSATION_FOLLOWUP_MS=30000

# ── Echo cancellation / duplex gate ──────────────────────────────────────────
DUPLEX_NOISE_FLOOR=110
DUPLEX_NOISE_MULTIPLIER=3.54
DUPLEX_BARGE_IN_RMS=1200
DUPLEX_MAX_ECHO_LAG_MS=200
DUPLEX_HANGOVER_MS=900
DUPLEX_ECHO_THRESHOLD=0.72
MIC_MUTE_GRACE_MS=650
MIC_FILTER_ENABLED=true
MIC_HIGHPASS_HZ=80
MIC_LOWPASS_HZ=7600

# ── Wake word ────────────────────────────────────────────────────────────────
# Empty = use your trained models/wake-word/jarvis.onnx if present, else the built-in "hey_jarvis".
OPENWAKEWORD_MODELS=
OPENWAKEWORD_ENABLED=true
OPENWAKEWORD_THRESHOLD=0.18
OPENWAKEWORD_STRONG_THRESHOLD=0.55
OPENWAKEWORD_CONFIRM_THRESHOLD=0.06
OPENWAKEWORD_CONFIRM_WINDOW_FRAMES=4
OPENWAKEWORD_CONFIRM_COUNT=2
OPENWAKEWORD_PERSONAL_THRESHOLD=0.8
OPENWAKEWORD_PERSONAL_STRONG=0.98
OPENWAKEWORD_DIAGNOSTIC_FLOOR=0.03
OPENWAKEWORD_INPUT_GAIN=3
OPENWAKEWORD_RESTART_BASE_MS=2000
OPENWAKEWORD_RESTART_MAX_MS=30000
# Optional whisper.cpp wake detector; needs WHISPER_WAKE_BINARY and WHISPER_WAKE_MODEL paths.
WHISPER_WAKE_ENABLED=false
WHISPER_WAKE_BINARY=
WHISPER_WAKE_MODEL=
WHISPER_WAKE_LANGUAGE=en
WHISPER_WAKE_WINDOW_MS=3000
WHISPER_WAKE_INTERVAL_MS=1500
WHISPER_WAKE_COOLDOWN_MS=5000
WHISPER_WAKE_TIMEOUT_MS=15000
# Apple Metal warms up shaders on first run, so the first decode can be slow.
WHISPER_WAKE_COLD_START_TIMEOUT_MS=45000
WAKEWORD_THRESHOLD=0.35
CLAP_TRIGGER_ENABLED=true
CLAP_SPIKE_RATIO=4
CLAP_ABS_FLOOR=250
ENERGY_MIN_STT=120
HOTWORD_COOLDOWN_MS=3000
VOICE_ACTIVITY_THRESHOLD=150
VOICE_AGENT_HANDOFF_MS=60000

# ── Assistant behaviour ──────────────────────────────────────────────────────
# payments = confirm only money | strict = also email, deletion, forms | off = never ask
JARVIS_CONFIRM_MODE=payments
JARVIS_FULL_AUTONOMY=false
JARVIS_ALWAYS_LISTEN=true
JARVIS_NAME=Jarvis
JARVIS_LANG=en-US
JARVIS_VOICE_STYLE=cinematic-robot
JARVIS_PRIVACY_MODE=false
JARVIS_FOCUS_MODE=false
JARVIS_MEETING_MODE=false
JARVIS_CHAT_ID=
ACTION_CONFIRMATION_TTL_MS=30000
DESKTOP_CONTROL_ENABLED=true

# ── OpenClaw agent ───────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_TIMEOUT_MS=300000
AGENT_LONG_TASK_NOTICE_MS=270000
AGENT_PERSISTENT_RETRY_MS=300000
AGENT_PERSISTENT_RECOVERY_WINDOW_MS=2592000000
AGENT_PERSISTENT_PROGRESS_MS=180000
AGENT_PERSISTENT_RUNNER_SCAN_MS=30000
AGENT_PERSISTENT_STALE_RUNNING_MS=600000
RUN_TASK_TIMEOUT_MS=180000
SELF_HEAL_ENABLED=true
SELF_HEAL_MAX_ATTEMPTS=2
SELF_HEAL_TIMEOUT_MS=180000
SELF_HEAL_INTERPRETER_PATH=

# ── Missions ─────────────────────────────────────────────────────────────────
# routine = local work without asking | strict = confirm every step
MISSION_AUTONOMY=routine
# Daily token alert threshold (notifies, never blocks). Empty = no alert.
MISSION_DAILY_TOKEN_BUDGET=
PROJECTS_ENABLED=true

# ── Telegram (optional remote control) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Your private Telegram user ID. Empty = pair with /pair <code> from the bot log.
TELEGRAM_OWNER_IDS=
TELEGRAM_CHAT_ID=
TELEGRAM_VIDEO_NOTE_MAX_BYTES=20971520
TELEGRAM_VIDEO_NOTE_MAX_SECONDS=90
TELEGRAM_MIRROR_VOICE=false

# ── Google: Gmail and Calendar (optional; run scripts/google-oauth-setup.js) ─
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Empty = this Mac's timezone.
TIMEZONE=
GMAIL_TASK_NOTIFICATIONS_ENABLED=false
GMAIL_OWNER_RECIPIENT=
GMAIL_TASK_PROGRESS_MS=21600000

# ── Home Assistant (optional) ────────────────────────────────────────────────
# Local URL (e.g. http://homeassistant.local:8123) and a Long-Lived Access Token.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_MS=8000
HOME_ASSISTANT_ALLOWED_DOMAINS=light,switch,fan,climate,media_player,scene,script,automation,input_boolean
# Empty = every allowed domain above; narrow it with e.g. light.office,switch.desk or light.*
HOME_ASSISTANT_ALLOWED_ENTITIES=
# Locks, alarms and covers. Even when true, every such action needs explicit confirmation.
HOME_ASSISTANT_ALLOW_SECURITY_ACTIONS=false

# ── Memory (Obsidian notes + optional PostgreSQL/pgvector index) ─────────────
OBSIDIAN_VAULT="~/Documents/Obsidian Vault"
MEMORY_DIR=./memory
MEMORY_MAX_ENTRIES=500
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=postgres
PGPASSWORD=
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_KEY=
AZURE_EMBEDDING_DEPLOYMENT=
AZURE_EMBEDDING_API_DEPLOYMENT=text-embedding-3-large
AZURE_RERANK_ENDPOINT=
AZURE_RERANK_KEY=
AZURE_RERANK_DEPLOYMENT=

# ── Optional extra models ────────────────────────────────────────────────────
# Separate Azure speech-to-text deployment (fallback when local whisper and Gemini fail).
AZURE_TRANSCRIBE_ENDPOINT=
AZURE_TRANSCRIBE_KEY=
AZURE_TRANSCRIBE_DEPLOYMENT=
AZURE_TERRA_ENDPOINT=
AZURE_TERRA_KEY=
AZURE_TERRA_DEPLOYMENT=
# Grok: strong reasoning model for mission planning and final checks (~50k tokens/min limit).
GROK_ENABLED=false
GROK_ENDPOINT=
GROK_KEY=
GROK_DEPLOYMENT=grok-4.6
GROK_TPM=45000

# ── Background jobs ──────────────────────────────────────────────────────────
SCREEN_MONITOR_ENABLED=true
SCREEN_MONITOR_INTERVAL=30000
SCREEN_MONITOR_THRESHOLD=15
SCREEN_MONITOR_VISION_COOLDOWN=120000
PROACTIVE_ENABLED=false
PROACTIVE_INTERVAL_MIN=30
PROACTIVE_COOLDOWN_MIN=30
PROACTIVE_DAILY_BUDGET=8
PROACTIVE_CONTEXT_MEMORY=10
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=22
DAILY_VOICE_MINUTES_ALERT=240

# ── Local services ───────────────────────────────────────────────────────────
DASHBOARD_PORT=7890
GODS_EYE_VIEW_ENABLED=true
GODS_EYE_VIEW_PORT=4173
CHROME_DEFAULT_PROFILE=Default

# ── Internals ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
COMMAND_DEDUP_MS=5000
RESPONSE_DEDUP_MS=15000
TURN_STALE_TIMEOUT_MS=600000
TURN_JOURNAL_MAX_BYTES=8388608
TURN_JOURNAL_RETENTION_FILES=5
