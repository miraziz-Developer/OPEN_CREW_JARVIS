# ═════════════════════════════════════════════════════════════
# JARVIS — English Realtime AI Agent Configuration
# ────────────────────────────────────────────────────────────
# Kalitlarni to'ldiring, .env.example ni .env nusxasi sifatida ishlating.
# HECH QACHON haqiqiy qiymatlarni .env.example ga YOZMAY  va gitga COMMIT qilma.
# ═════════════════════════════════════════════════════════════

# ┌───────────────────────────────────────────────────────────┐
# │  1. AZURE SPEECH SERVICE (STT + TTS) — Majburiy           │
# └───────────────────────────────────────────────────────────┘
# ┌───────────────────────────────────────────────────────────┐
# │  1. AZURE SPEECH SERVICE (STT + TTS) — Majburiy           │
# └───────────────────────────────────────────────────────────┘
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=...
# Unified neural English voice (SOUL.md default). This fixes the dual-voice bug.
# Both realtime (VoiceLive/Realtime API) and azure-tts/pause-sentinel now use the same voice.
JARVIS_VOICE=en-US-AndrewNeural
AZURE_SPEECH_VOICE=en-US-AndrewNeural
AZURE_SPEECH_LANGUAGE=en-US
# Fallback TTS'ni Realtime Cedar/Andrew profiliga yaqinroq qiladi.
AZURE_SPEECH_RATE_PERCENT=-12
AZURE_SPEECH_PITCH_PERCENT=-12

AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=...
AZURE_SPEECH_VOICE=en-US-GuyNeural
AZURE_SPEECH_LANGUAGE=en-US
# Fallback TTS'ni Realtime Cedar profiliga yaqinroq, qalinroq va vazminroq qiladi.
AZURE_SPEECH_RATE_PERCENT=-12
AZURE_SPEECH_PITCH_PERCENT=-12

# ┌───────────────────────────────────────────────────────────┐
# │  2. AI PROVIDER — Azure OpenAI Responses API               │
# └───────────────────────────────────────────────────────────┘
AZURE_OPENAI_ENDPOINT=...
AZURE_OPENAI_KEY=...
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
# Foundry project reasoning tiers: qisqa/tez fikrlash Grok bilan, murakkab
# architecture, strategy va ko'p bosqichli rejalash GPT-5.6 Sol bilan bajariladi.
# Endpoint `/openai/v1` bilan tugashi mumkin; haqiqiy key faqat .env ichida qoladi.
DEEP_THINK_FAST_MODEL=grok-4-1-fast-reasoning
DEEP_THINK_COMPLEX_MODEL=gpt-5.6-sol
OPENCLAW_AGENT_TIMEOUT_MS=300000
DEEP_THINK_TIMEOUT_MS=240000
# Long-running tasks notify before their deadline instead of seeming cancelled.
AGENT_LONG_TASK_NOTICE_MS=270000
# Retryable provider failures use 5s, 15s, 45s and 135s backoff first.
# Persistent work automatically recovers for up to 30 days, then pauses.
AGENT_PERSISTENT_RETRY_MS=300000
AGENT_PERSISTENT_RECOVERY_WINDOW_MS=2592000000
AGENT_PERSISTENT_PROGRESS_MS=180000
AGENT_PERSISTENT_RUNNER_SCAN_MS=30000
AGENT_PERSISTENT_STALE_RUNNING_MS=600000
AZURE_VOICELIVE_ENDPOINT=https://YOUR-VOICE-RESOURCE.services.ai.azure.com
AZURE_VOICELIVE_KEY=...
AZURE_VOICELIVE_MODEL=gpt-realtime
# Now defers to JARVIS_VOICE (en-US-AndrewNeural) for consistency. Change JARVIS_VOICE if you want a different neural English voice.
AZURE_VOICELIVE_VOICE=en-US-AndrewNeural
AZURE_VOICELIVE_API_VERSION=2026-04-10

# Voice Live ishlamasa stable direct Azure OpenAI Realtime fallback.
AZURE_REALTIME_ENDPOINT=https://YOUR-REALTIME-RESOURCE.openai.azure.com
AZURE_REALTIME_KEY=...
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-1.5
# Realtime voice now unified via JARVIS_VOICE (maps to neural English). Avoids previous cedar vs GuyNeural conflict.
AZURE_REALTIME_VOICE=en-US-AndrewNeural

# Routine local actions may proceed without repeated confirmation when true.
# Payment, irreversible deletion, external communication, and credential or
# permission changes always require explicit confirmation.
JARVIS_FULL_AUTONOMY=true
# Safe local dependency repair is limited to a validated single package and two attempts.
SELF_HEAL_ENABLED=true
SELF_HEAL_MAX_ATTEMPTS=2
SELF_HEAL_TIMEOUT_MS=180000
SELF_HEAL_INTERPRETER_PATH=/opt/homebrew/bin/interpreter
VOICE_AGENT_HANDOFF_MS=60000
DEEP_THINK_MAX_TOKENS=1200
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4.1
# Astra javob bermasa ishlaydigan alohida reasoning fallback.
AZURE_TERRA_ENDPOINT=https://YOUR-TERRA-RESOURCE.services.ai.azure.com
AZURE_TERRA_KEY=...
AZURE_TERRA_DEPLOYMENT=gpt-5.6-terra

# Reasoning/vision credentiallarini voice va retrieval credentiallari bilan
# aralashtirmang. Haqiqiy keylarni faqat .env ichiga yozing.
AZURE_VOICELIVE_ENDPOINT=https://YOUR-VOICE-RESOURCE.services.ai.azure.com
AZURE_VOICELIVE_KEY=...
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_VOICE=en-US-OnyxTurboMultilingualNeural
AZURE_VOICELIVE_API_VERSION=2026-04-10

# Voice Live ishlamasa stable direct Azure OpenAI Realtime fallback.
AZURE_REALTIME_ENDPOINT=https://YOUR-REALTIME-RESOURCE.openai.azure.com
AZURE_REALTIME_KEY=...
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-1.5
AZURE_REALTIME_VOICE=cedar

# Tabiiy suhbat: to'liq audio javob va ishonchli duplex interruption.
REALTIME_IDLE_MS=20000
# Jarvis javobini aytib bo'lgach, shu vaqt ichida "Jarvis" demasdan davom eting.
CONVERSATION_FOLLOWUP_MS=60000
REALTIME_MAX_RESPONSE_TOKENS=1024
REALTIME_FAST_ACTION_MAX_RESPONSE_TOKENS=256
REALTIME_BARGE_IN_CONFIRM_MS=420
REALTIME_BARGE_IN_MAX_GAP_MS=80
# Leave empty to detect Uzbek, English, and other spoken languages automatically.
# Set a BCP-47 locale only when the deployment intentionally needs a fixed STT language.
REALTIME_TRANSCRIPTION_LANGUAGE=
# Server VAD turnni yopishi uchun kamida media silence (750 ms) + bir chunk.
DUPLEX_HANGOVER_MS=900

# Ixtiyoriy authoritative STT, semantic memory va reranking providerlari.
AZURE_TRANSCRIBE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/gpt-live-transcribe/audio/transcriptions?api-version=2025-03-01-preview
AZURE_TRANSCRIBE_KEY=...
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-live-transcribe
AZURE_EMBEDDING_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AZURE_EMBEDDING_KEY=...
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large-2
AZURE_RERANK_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/providers/cohere/v2/rerank
AZURE_RERANK_KEY=...
AZURE_RERANK_DEPLOYMENT=Cohere-rerank-v4.0-pro

# IKKI MARTA QARSAK TRIGGER
CLAP_TRIGGER_ENABLED=true
CLAP_SPIKE_RATIO=4
CLAP_ABS_FLOOR=250
WAKEWORD_THRESHOLD=0.35
# Built-in model always works. After training a personal model, use:
# OPENWAKEWORD_MODELS=hey_jarvis,models/wake-word/jarvis.onnx
OPENWAKEWORD_MODELS=hey_jarvis

# ┌───────────────────────────────────────────────────────────┐
# │  3. DESKTOP CONTROL (autonomous kompyuter boshqaruvi)     │
# └───────────────────────────────────────────────────────────┘
DESKTOP_CONTROL_ENABLED=true
DESKTOP_APPROVAL_MODE=ask
DESKTOP_FAILSAFE_CORNER=bottom-right

# ┌───────────────────────────────────────────────────────────┐
# │  4. MEMORY — Xotira tizimi                                │
# └───────────────────────────────────────────────────────────┘
MEMORY_DIR=./memory
MEMORY_MAX_ENTRIES=500
OBSIDIAN_VAULT="~/Documents/Obsidian Vault"
OBSIDIAN_MEMORY_DIR="~/Documents/Obsidian Vault/memory"
OBSIDIAN_ENABLED=true

# ┌───────────────────────────────────────────────────────────┐
# │  5. MESSAGING — Telegram / Discord / Email                │
# └───────────────────────────────────────────────────────────┘
# TELEGRAM_BOT_TOKEN=...
# Telegram dumaloq videolari uchun xavfsiz processing limitlari.
TELEGRAM_VIDEO_NOTE_MAX_BYTES=20971520
TELEGRAM_VIDEO_NOTE_MAX_SECONDS=90
# DISCORD_BOT_TOKEN=...

# OpenClaw gateway uchun kamida 32 byte tasodifiy token yarating:
# openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=...

# Ixtiyoriy: bepul, to'liq lokal "Hey Jarvis" wake-word.
# Birinchi marta: ./scripts/setup-openwakeword.sh
OPENWAKEWORD_ENABLED=true
OPENWAKEWORD_RESTART_BASE_MS=2000
OPENWAKEWORD_RESTART_MAX_MS=30000
# Pastroq qiymat sezgirroq; false-positive ko'payishi mumkin.
# Aksent va noutbuk mikrofoni uchun temporal tasdiqlash: 320ms oyna ichida
# bitta asosiy score va bitta yumshoq score talab qilinadi. False trigger bo'lsa
# asosiy thresholdni 0.22–0.30 oralig'iga ko'taring.
OPENWAKEWORD_THRESHOLD=0.18
OPENWAKEWORD_STRONG_THRESHOLD=0.55
OPENWAKEWORD_CONFIRM_THRESHOLD=0.06
OPENWAKEWORD_CONFIRM_WINDOW_FRAMES=4
OPENWAKEWORD_CONFIRM_COUNT=2
OPENWAKEWORD_DIAGNOSTIC_FLOOR=0.03
OPENWAKEWORD_INPUT_GAIN=3
# Ixtiyoriy: whisper.cpp transcript orqali lokal wake fallback. Bu Azure
# Realtime STT/VAD o'rnini bosmaydi; faqat daemon listening holatida ishlaydi.
# whisper.cpp binary va Tiny modelni absolute path bilan ko'rsating.
WHISPER_WAKE_ENABLED=false
# WHISPER_WAKE_BINARY=/absolute/path/to/whisper-cli
# WHISPER_WAKE_MODEL=/absolute/path/to/ggml-tiny.en.bin
WHISPER_WAKE_LANGUAGE=en
WHISPER_WAKE_WINDOW_MS=3000
WHISPER_WAKE_INTERVAL_MS=1500
WHISPER_WAKE_COOLDOWN_MS=5000
WHISPER_WAKE_TIMEOUT_MS=15000
# Barge-in tezligi: 180ms haqiqiy nutq playback'ni tez kesadi; qisqa tabiiy
# energiya pasayishi 80ms gacha candidate'ni yo'qotmaydi.
REALTIME_BARGE_IN_CONFIRM_MS=180
REALTIME_BARGE_IN_MAX_GAP_MS=80
# SMTP_HOST=...
# SMTP_USER=...
# SMTP_PASS=...

# ┌───────────────────────────────────────────────────────────┐
# │  6. PROACTIVE — Avtomatik proactive rejim                 │
# └───────────────────────────────────────────────────────────┘
PROACTIVE_ENABLED=false
PROACTIVE_INTERVAL_MIN=30
PROACTIVE_COOLDOWN_MIN=30
PROACTIVE_DAILY_BUDGET=8
PROACTIVE_CONTEXT_MEMORY=10
# Operational interruption controls. Privacy suppresses all proactive notices;
# focus/meeting mode allows only urgency >= 0.9.
JARVIS_PRIVACY_MODE=false
JARVIS_FOCUS_MODE=false
JARVIS_MEETING_MODE=false

# ┌───────────────────────────────────────────────────────────┐
# │  7. ADVANCED TTS — ElevenLabs (professional ovoz)         │
# └───────────────────────────────────────────────────────────┘
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# ┌───────────────────────────────────────────────────────────┐
# │  8. SEARCH & KNOWLEDGE                                    │
# └───────────────────────────────────────────────────────────┘
# SERPAPI_KEY=...
# GOOGLE_CSE_ID=...
# GOOGLE_CSE_API_KEY=...

# ┌───────────────────────────────────────────────────────────┐
# │  9. SYSTEM CONFIG                                         │
# └───────────────────────────────────────────────────────────┘
JARVIS_LANG=en-US
JARVIS_NAME=Jarvis
TIMEZONE=Asia/Kuala_Lumpur
LOG_LEVEL=info

# EKRAN KUZATUV (fon rejimida doim ishlaydi)
SCREEN_MONITOR_ENABLED=true
SCREEN_MONITOR_INTERVAL=20000
SCREEN_MONITOR_THRESHOLD=15
SCREEN_MONITOR_VISION_COOLDOWN=120000

# GOD'S EYE VIEW — isolated localhost 3D globe (vendor/gods-eye-view)
# API keylarsiz Esri satellite/OSM fallback ishlaydi. Provider keylarni Jarvis
# .env'iga emas, vendor/gods-eye-view/.env ichiga yozing.
GODS_EYE_VIEW_ENABLED=true
GODS_EYE_VIEW_PORT=4173

# DASHBOARD (http://localhost:7890, faqat mahalliy)
DASHBOARD_PORT=7890

# ┌───────────────────────────────────────────────────────────┐
# │  11. REALTIME VOICE — Haqiqiy real-vaqtli suhbat (gpt-realtime) │
# └───────────────────────────────────────────────────────────┘
REALTIME_ENABLED=true
REALTIME_IDLE_MS=20000
REALTIME_WAKE_PREROLL_MS=1800
# Provider endpoint/deployment/voice yuqoridagi alohida credential blokida.
# Original deep, controlled cinematic machine persona (not an actor clone).
JARVIS_VOICE_STYLE=cinematic-robot
REALTIME_TRANSCRIPTION_LANGUAGE=
REALTIME_VAD_SILENCE_MS=180
REALTIME_MEDIA_VAD_SILENCE_MS=750
REALTIME_MAX_RESPONSE_TOKENS=512
# Qisqa fast-action tasdiqlarining audiosi ham token limitiga kiradi; 40 juda
# past bo'lib, "Hozir soat 20:20" jumlasini o'rtasida kesib qo'ygan.
REALTIME_FAST_ACTION_MAX_RESPONSE_TOKENS=256
REALTIME_BARGE_IN_CONFIRM_MS=180
# Realtime PCM oqimidagi qisqa tarmoq jitterini yutish uchun boshlang'ich
# playback zaxirasi. Kamaytirish latency'ni, oshirish uzluksizlikni yaxshilaydi.
REALTIME_NORMAL_DUPLEX_HANGOVER_MS=330
REALTIME_PLAYBACK_PREBUFFER_MS=40
REALTIME_PLAYBACK_MAX_WAIT_MS=80
MIC_MUTE_GRACE_MS=650
DUPLEX_ECHO_THRESHOLD=0.72
DUPLEX_BARGE_IN_RMS=900
DUPLEX_NOISE_FLOOR=80
DUPLEX_NOISE_MULTIPLIER=2.4
DUPLEX_HANGOVER_MS=650
DUPLEX_MAX_ECHO_LAG_MS=180
RUN_TASK_TIMEOUT_MS=180000
# Accepted turn shu vaqt ichida terminal holatga yetmasa watchdog uni failed
# sifatida yopadi. Startup replay terminal turnlarni idempotent qayta yozadi.
TURN_STALE_TIMEOUT_MS=600000
# Follow-up references remain active across short voice sessions. High-impact
# actions require an explicit one-shot confirmation inside this TTL.
CONVERSATION_FOLLOWUP_MS=60000
ACTION_CONFIRMATION_TTL_MS=30000
# Durable addressed-turn journal rotation (8 MiB, five archived segments).
TURN_JOURNAL_MAX_BYTES=8388608
TURN_JOURNAL_RETENTION_FILES=5

# Voice tuning, deduplication va provider circuit-breaker
# Realtime mikrofon uchun kechikishsiz speech-band filtri: past g'uvillash va
# 16 kHz nutq diapazonidan tashqaridagi yuqori shovqinni SoX orqali kesadi.
MIC_FILTER_ENABLED=true
MIC_HIGHPASS_HZ=80
MIC_LOWPASS_HZ=7600
ENERGY_MIN_STT=120
VOICE_ACTIVITY_THRESHOLD=150
HOTWORD_COOLDOWN_MS=3000
COMMAND_DEDUP_MS=5000
RESPONSE_DEDUP_MS=15000
REALTIME_INPUT_GAIN=3
REALTIME_FAILURE_LIMIT=3
REALTIME_COOLDOWN_MS=120000

# Chrome ochilganda profil-tanlash oynasisiz to'g'ridan-to'g'ri shu profil ochilsin
CHROME_DEFAULT_PROFILE=Default

# Kunlik o'z-o'zini hisobot
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=22

# Ko'p bosqichli avtonom loyihalar
PROJECTS_ENABLED=true

# Google Calendar/Gmail integratsiyasi (OAuth2 Desktop app — console.cloud.google.com)
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
# Optional owner-only Gmail reporting. Run `node scripts/google-oauth-setup.js`
# Telegram inbound commands fail closed unless this is the owner's positive
# private Telegram user/chat ID. Groups and edited messages are never executed.
# TELEGRAM_CHAT_ID=123456789
# Owner commands: /tasks, /approve TASK_ID, /reject TASK_ID, /inbox (read-only).
# once after configuring the Google Desktop OAuth client. Token storage remains
# .google-tokens.json with mode 0600; never add it to source control.
# No recipient other than GMAIL_OWNER_RECIPIENT is ever sent automatic task mail.
GMAIL_TASK_NOTIFICATIONS_ENABLED=false
GMAIL_OWNER_RECIPIENT=owner@example.com
# Progress emails are rate-limited; completion and approval-needed are immediate.
GMAIL_TASK_PROGRESS_MS=21600000

# Doim eshitib turish (Azure Voice Live sessiyasi ochiq, faqat "Jarvis" deganda javob beradi). false — faqat wake-word/Fn.
JARVIS_ALWAYS_LISTEN=true
# Telegram egalari (har biri o'z shaxsiy chatida); TELEGRAM_CHAT_ID — asosiy ega
TELEGRAM_OWNER_IDS=

# Avtonom missiyalar: kunlik LLM token chegarasi (oshsa yangi qadamlar to'xtaydi), doim eshitish ovoz ogohlantirishi (daqiqa)
MISSION_DAILY_TOKEN_BUDGET=3000000
DAILY_VOICE_MINUTES_ALERT=240
# routine: oddiy lokal amallar tasdiqsiz; strict: hammasi tasdiqli
MISSION_AUTONOMY=routine

# Telegramga har bir ovozli gap va javobni nusxalash (standart o'chiq: juda ko'p shovqin)
TELEGRAM_MIRROR_VOICE=false
