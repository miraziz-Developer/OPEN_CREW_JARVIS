# ═════════════════════════════════════════════════════════════
# 🇺🇿 JARVIS v3 — Real AI Agent Configuration
# ────────────────────────────────────────────────────────────
# Kalitlarni to'ldiring, .env.example ni .env nusxasi sifatida ishlating.
# HECH QACHON haqiqiy qiymatlarni .env.example ga YOZMAY  va gitga COMMIT qilma.
# ═════════════════════════════════════════════════════════════

# ┌───────────────────────────────────────────────────────────┐
# │  1. AZURE SPEECH SERVICE (STT + TTS) — Majburiy           │
# └───────────────────────────────────────────────────────────┘
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=...
AZURE_SPEECH_VOICE=uz-UZ-SardorNeural
AZURE_SPEECH_LANGUAGE=uz-UZ

# ┌───────────────────────────────────────────────────────────┐
# │  2. AI PROVIDER — Azure OpenAI / Kimi via Azure           │
# └───────────────────────────────────────────────────────────┘
AZURE_OPENAI_ENDPOINT=...
AZURE_OPENAI_KEY=...
AZURE_OPENAI_DEPLOYMENT=Kimi-K2.6

# ┌───────────────────────────────────────────────────────────┐
# │  3. DESKTOP CONTROL (autonomous kompyuter boshqaruvi)     │
# └───────────────────────────────────────────────────────────┘
DESKTOP_CONTROL_ENABLED=true
DESKTOP_APPROVAL_MODE=auto
DESKTOP_FAILSAFE_CORNER=bottom-right

# ┌───────────────────────────────────────────────────────────┐
# │  4. MEMORY — Xotira tizimi                                │
# └───────────────────────────────────────────────────────────┘
MEMORY_DIR=./memory
MEMORY_MAX_ENTRIES=500
OBSIDIAN_VAULT="~/Documents/Obsidian Vault"
OBSIDIAN_MEMORY_DIR="~/Documents/Obsidian Vault/memory"
OBSIDIAN_ENABLED=true

# ┌───────────────────────────────────────────────────────────┐
# │  5. MESSAGING — Telegram / Discord / Email                │
# └───────────────────────────────────────────────────────────┘
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...
# SMTP_HOST=...
# SMTP_USER=...
# SMTP_PASS=...

# ┌───────────────────────────────────────────────────────────┐
# │  6. PROACTIVE — Avtomatik proactive rejim                 │
# └───────────────────────────────────────────────────────────┘
PROACTIVE_ENABLED=false
PROACTIVE_INTERVAL_MIN=30
PROACTIVE_CONTEXT_MEMORY=10

# ┌───────────────────────────────────────────────────────────┐
# │  7. ADVANCED TTS — ElevenLabs (professional ovoz)         │
# └───────────────────────────────────────────────────────────┘
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# ┌───────────────────────────────────────────────────────────┐
# │  8. SEARCH & KNOWLEDGE                                    │
# └───────────────────────────────────────────────────────────┘
# SERPAPI_KEY=...
# GOOGLE_CSE_ID=...
# GOOGLE_CSE_API_KEY=...

# ┌───────────────────────────────────────────────────────────┐
# │  9. SYSTEM CONFIG                                         │
# └───────────────────────────────────────────────────────────┘
JARVIS_LANG=uz-UZ
JARVIS_NAME=Jarvis
TIMEZONE=Asia/Kuala_Lumpur
LOG_LEVEL=info

# ═════════════════════════════════════════════════════════════
# │  10. ULTRA — Advanced Capabilities                        │
# ═════════════════════════════════════════════════════════════

FACE_RECOGNITION_ENABLED=false
FACE_RECOGNITION_THRESHOLD=0.6
WEBCAM_DEVICE=0
FACE_KNOWN_DIR=./memory/faces
FACE_DETECTION_INTERVAL_MS=3000

EMOTION_DETECTION_ENABLED=false
EMOTION_AZURE_ENDPOINT=...
EMOTION_LOCAL_MODE=true

GESTURE_ENABLED=false
GESTURE_TRACKPAD=auto
GESTURE_COMMANDS=true
