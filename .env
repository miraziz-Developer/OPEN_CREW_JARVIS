# ┌───────────────────────────────────────────────────────────┐
# │  3. DESKTOP CONTROL (autonomous kompyuter boshqaruvi)     │
# │     clawhub install desktop-control                       │
# └───────────────────────────────────────────────────────────┘
DESKTOP_CONTROL_ENABLED=true
DESKTOP_APPROVAL_MODE=auto
DESKTOP_FAILSAFE_CORNER=bottom-right

# ┌───────────────────────────────────────────────────────────┐
# │  4. MEMORY — Xotira tizimi                                │
# └───────────────────────────────────────────────────────────┘
