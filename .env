# ┌───────────────────────────────────────────────────────────┐
# │  6. SCREEN MONITOR — Trigger-asosli ekran kuzatuv         │
# └───────────────────────────────────────────────────────────┘
SCREEN_MONITOR_ENABLED=true
SCREEN_MONITOR_INTERVAL=90000
SCREEN_MONITOR_THRESHOLD=15

# ┌───────────────────────────────────────────────────────────┐
# │  7. PROACTIVE — Avtomatik proactive rejim                 │
# │     Jarvis o'zi fikrlab ish qiladi                        │
# └───────────────────────────────────────────────────────────┘
