MEMORY_MAX_ENTRIES=500
OBSIDIAN_VAULT=~/Documents/Obsidian Vault
OBSIDIAN_MEMORY_DIR=~/Documents/Obsidian Vault/memory
OBSIDIAN_ENABLED=true

# ┌───────────────────────────────────────────────────────────┐
# │  5. MESSAGING — Telegram / Discord / Email                │
# └───────────────────────────────────────────────────────────┘
