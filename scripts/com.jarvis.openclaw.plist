<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jarvis.openclaw</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/jarvis.sh</string>
  </array>

  <!-- Start automatically when the Mac boots -->
  <key>RunAtLoad</key>
  <true/>

  <!-- If the process stops, launchd restarts it automatically -->
  <key>KeepAlive</key>
  <true/>

  <!-- Restart throttle interval (seconds) -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/launchd.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/launchd.stderr.log</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Flag so it greets on every system restart -->
    <key>JARVIS_AUTOSTART</key>
    <string>1</string>
    <!-- Handle output even without a terminal -->
    <key>FORCE_COLOR</key>
    <string>0</string>
  </dict>
</dict>
</plist>
