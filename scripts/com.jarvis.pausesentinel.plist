  <key>StandardErrorPath</key>
  <string>/Users/mirazizerkinaliyev_dev/projects/OPEN_CREW_JARVIS/logs/pause-sentinel.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/mirazizerkinaliyev_dev/projects/OPEN_CREW_JARVIS</string>

  <key>EnvironmentVariables</key>
