<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jarvis.pausesentinel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/mirazizerkinaliyev_dev/projects/OPEN_CREW_JARVIS/scripts/pause-sentinel.js</string>
  </array>

  <!-- Kompyuter yonganda avtomatik ishga tushsin — Jarvis o'zi to'xtatilgan
